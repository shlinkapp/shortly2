# Turso / LibSQL Database
# For local dev: TURSO_DATABASE_URL=file:local.db (no token needed)
# For Turso cloud: TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=
# Production skips request-time schema setup by default. Enable only as a temporary migration fallback.
DATABASE_AUTO_INIT=
# Optional: one-time opt-in rebuild of short_link for legacy databases that still
# carry a unique slug index. Run it on a SINGLE instance only.
DATABASE_LEGACY_REBUILD=
# Optional: libSQL request timeout in milliseconds (default 15000).
DATABASE_REQUEST_TIMEOUT_MS=15000
# Optional: log every Drizzle query with its parameters (debug only).
DATABASE_QUERY_LOG=false

# Better Auth
BETTER_AUTH_SECRET=change-this-to-a-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
API_KEY_PEPPER=
# Optional: comma-separated emails that should become admin on first sign-in
BOOTSTRAP_ADMIN_EMAILS=
# Whether to trust X-Forwarded-For chain for client IP detection
TRUST_X_FORWARDED_FOR=true
# How many trusted proxy hops are in front of the app (used with X-Forwarded-For)
TRUST_PROXY_HOPS=1

# GitHub OAuth (optional — leave blank to disable GitHub login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Resend (optional — leave blank to disable email OTP login)
RESEND_API_KEY=
RESEND_FROM_EMAIL=shortly@example.com

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Inbound temp email
# Shared secret for POST /v1/emails/inbound. Must match the Cloudflare email worker secret.
INBOUND_EMAIL_SECRET=

# Telegram inbound notifications (optional)
# Bot token used by the main app to push new temp-email notifications to bound Telegram chats.
# This should be the same bot token configured in .cf-tgbot-worker.
TELEGRAM_BOT_TOKEN=
